# rm renames the tree aside immediately (deferred delete) and prunes the entry
exec git init -q -b main repo
cd repo
exec git commit -q --allow-empty -m init
exec nt feature
exists ../repo.worktrees/feature

exec nt rm feature
stdout 'removed'
# the original path is gone the instant rm returns (renamed aside)
! exists ../repo.worktrees/feature
exec git worktree list
! stdout 'feature'

# removing the main checkout is refused
! exec nt rm main
stderr 'refusing to remove the main checkout'

# an unknown target removes nothing
! exec nt rm no-such-worktree
stderr 'no worktree for branch or path'

# forcing a parent removal refuses an unnamed nested worktree
exec nt nestp
exec git worktree add -q ../repo.worktrees/nestp/child -b nestp-child
cp ../precious ../repo.worktrees/nestp/child/uncommitted.txt
exec git -C ../repo.worktrees/nestp/child status --short
stdout 'uncommitted.txt'
! exec nt rm -f nestp
stderr 'refusing to remove .*nestp: contains nested worktree .*nestp/child'
exists ../repo.worktrees/nestp
exists ../repo.worktrees/nestp/child
exec git worktree list
stdout 'nestp/child'

# Naming a locked child must not let its parent bypass Git's refusal.
exec git worktree lock ../repo.worktrees/nestp/child
! exec nt rm -f nestp nestp-child
cmp ../repo.worktrees/nestp/child/uncommitted.txt ../precious
exec git worktree list
stdout 'nestp/child'
exec git worktree unlock ../repo.worktrees/nestp/child

# naming both worktrees preserves the existing successful batch behavior
exec nt rm -f nestp nestp-child
! exists ../repo.worktrees/nestp
! exists ../repo.worktrees/nestp/child
exec git worktree list
! stdout 'nestp'

-- precious --
precious
